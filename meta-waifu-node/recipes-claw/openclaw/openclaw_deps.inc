python () {
    import base64
    npm_deps = d.getVar('NPM_DEPS') + d.getVar('DEV_DEPS')
    for dep in npm_deps.split():
        fields=dep.split("::")
        d.appendVar("SRC_URI", " "+fields[3]+";unpack=0;name="+fields[0]+" ")
        # Only set sha sum for entries that have integrity (shrinkwrap entries)
        integrity = fields[4]
        if integrity:  # non-empty means real sha from shrinkwrap
            sum=integrity.split("-")
            d.setVarFlag("SRC_URI",fields[0]+"."+sum[0]+"sum",base64.b64decode(sum[1]).hex())
}


